# Any OpenAI-compatible provider works (NVIDIA, Gemini, ...). See README for examples.
# The older NVIDIA_API_KEY / NVIDIA_MODEL / NVIDIA_BASE_URL names are still accepted as a fallback.

# API key of the provider (NVIDIA keys start with nvapi-)
AI_API_KEY=

# Model id to chat with. Run `npm run models` to list the available ones.
# Example (NVIDIA): meta/llama-3.3-70b-instruct
AI_MODEL=

# OpenAI-compatible endpoint. Optional: defaults to NVIDIA (https://integrate.api.nvidia.com/v1).
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Local tests against the mock server: http://localhost:4010/v1
AI_BASE_URL=

# Optional: model options the user can pick per conversation (a chip next to the send button).
# Comma-separated entries: key|model id|Hebrew label|short Hebrew description|effort|vision
#   effort: none / low / medium / high, off = don't send it (models that reject it, e.g. Flash-Lite),
#           empty = AI_REASONING_EFFORT; vision: 1 = accepts images, 0 = text only
# The first entry is the default. Unset: a single option from AI_MODEL, no picker, no image upload.
# Only key, label, description, vision, quota group (an entry key) and a readable model name
# derived from the id ("gemini-3.6-flash" -> "Gemini 3.6 Flash") reach the browser.
# Gemini's free tier limits requests per day *per model*, so a backup entry on another model helps.
# AI_MODELS=fast|gemini-3.6-flash|מהיר|לרוב השאלות|none|1,deep|gemini-3.6-flash|מעמיק|לשאלות מורכבות, איטי יותר|medium|1,alt|gemini-3.1-flash-lite|חלופה|עברית טובה, מתחיל לענות לאט יותר|off|1,lite|gemini-3.5-flash-lite|גיבוי|הכי מהיר, עברית פחות מדויקת|off|1

# Optional: how much reasoning models think before answering (none / low / medium / high).
# Defaults to none (fastest first token). Set it to an empty value if your provider rejects
# the reasoning_effort parameter.
# AI_REASONING_EFFORT=none


# The code your friend types on the login page. Pick something long and hard to guess.
# A link https://<site>/?k=<ACCESS_CODE> logs in directly (the code is removed from the address bar).
# Login lasts 365 days. Leave EMPTY to turn the gate off: anyone with the URL can use the site.
ACCESS_CODE=

# Local image-worker only: Python with PyTorch/Transformers and the downloaded
# Hebrew-English model. See scripts/image-worker/LOCAL_TRANSLATION.md.
# Use forward slashes on Windows. This is not needed on Vercel.
# IMAGE_TRANSLATION_PYTHON=C:/path/to/environment/Scripts/python.exe

# ---- Optional: image & video generation through the owner's OpenArt account (MCP) ----
# Upstash Redis (Vercel Marketplace → Upstash) stores the encrypted OpenArt tokens, the refresh
# lock and the daily credit counter. Either naming works:
# KV_REST_API_URL=            or UPSTASH_REDIS_REST_URL=
# KV_REST_API_TOKEN=          or UPSTASH_REDIS_REST_TOKEN=
# 32 random bytes, base64, encrypts the token set at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPENART_TOKEN_KEY=
# Owner-only code for /admin/openart (connect / reconnect / disconnect). Not the friend's code.
ADMIN_CODE=
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to the daily token keep-alive.
CRON_SECRET=
# Optional daily credit cap for generations (Israel calendar day). Unset, empty or 0 = no limit.
# OPENART_DAILY_CREDIT_CAP=200
# Allowlisted options, comma-separated: key|model id|Hebrew label|short Hebrew description|settings
# settings: a=b;c=d (must match the model's OpenArt form). Defaults:
# OPENART_IMAGE_MODELS=lite|nano-banana-2-lite|חסכוני|תמונה מהירה וזולה|,nb2|nano-banana-2|איכותי|פרטים עשירים יותר|resolution=1K
# OPENART_VIDEO_MODELS=pixverse|pixverseV6|סרטון קצר|5 שניות, 540p|duration=5;resolution=540p;generateAudio=false,veo|veo3-1|סרטון איכותי|4 שניות, 720p, עם שמע|duration=4;resolution=720p;mode=lite
