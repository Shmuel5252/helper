# Any OpenAI-compatible provider works (NVIDIA, Gemini, ...). See README for examples.
# The older NVIDIA_API_KEY / NVIDIA_MODEL / NVIDIA_BASE_URL names are still accepted as a fallback.

# API key of the provider (NVIDIA keys start with nvapi-)
AI_API_KEY=

# Model id to chat with. Run `npm run models` to list the available ones.
# Example (NVIDIA): meta/llama-3.3-70b-instruct
AI_MODEL=

# OpenAI-compatible endpoint. Optional: defaults to NVIDIA (https://integrate.api.nvidia.com/v1).
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Local tests against the mock server: http://localhost:4010/v1
AI_BASE_URL=

# Optional: how much reasoning models think before answering (none / low / medium / high).
# Defaults to none (fastest first token). Set it to an empty value if your provider rejects
# the reasoning_effort parameter.
# AI_REASONING_EFFORT=none

# The code your friend types on the login page. Pick something long and hard to guess.
ACCESS_CODE=
