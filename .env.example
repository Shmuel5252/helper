# NVIDIA API key (from build.nvidia.com -> "Get API Key"). Starts with nvapi-
NVIDIA_API_KEY=

# Model id to chat with. Run `npm run models` to list the available ones.
# Example: meta/llama-3.3-70b-instruct
NVIDIA_MODEL=

# The code your friend types on the login page. Pick something long and hard to guess.
ACCESS_CODE=

# Optional, local testing only: point the chat API at a mock OpenAI-compatible server.
# NVIDIA_BASE_URL=http://localhost:4010/v1
